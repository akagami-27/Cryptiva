  browser["User browser<br/>React application"]

  subgraph local["Local development"]
    vite["Vite dev server<br/>127.0.0.1:5173"]
    backendDev["Node.js / Express<br/>configured PORT; commonly 3100 locally"]
  end

  subgraph production["Kubernetes deployment as declared in manifests"]
    ingress["Ingress resource<br/>TLS host and certificate secret configured<br/>cluster state unverified"]
