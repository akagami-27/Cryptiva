    temp["/app/tmp<br/>plaintext upload staging<br/>size-limited emptyDir"]
    scanner["ClamAV process<br/>runs in application container"]
    crypto["Crypto service<br/>AES-256-GCM, wrapped DEKs,<br/>SHA-256 verification"]
    share["Share-flow controls<br/>token/password checks, expiry,<br/>download limits and reservations"]
  end

  subgraph services["Configured data services; hosting and live connectivity unverified"]
    mongo["MongoDB<br/>users, file/share metadata,<br/>sessions, rate-limit buckets, audit logs"]
    storage["Supabase Storage<br/>encrypted file objects"]
  end

  browser -->|"local page/assets"| vite
  vite -->|"proxied API paths; target configured as 127.0.0.1:3100"| backendDev
